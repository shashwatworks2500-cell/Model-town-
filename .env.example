# Canonical origin. Used for metadata, Open Graph URLs, robots.txt and the
# sitemap. Public by design — it is the site's own address.
NEXT_PUBLIC_SITE_URL="https://model-town.example"

# Where enquiries are forwarded. Server-only: it is read inside the route
# handler and never reaches the browser.
#
# Until this is set, POST /api/enquiry returns 503 and the form tells the
# visitor that nothing was sent and to use the direct contact details instead.
# That is deliberate — the form never shows a success state for a message it
# did not deliver.
ENQUIRY_WEBHOOK_URL=""
